CREATE TABLE kiroha_sync_cursor(
    space_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(space_id, device_id)
);

CREATE INDEX kiroha_sync_cursor_device_index ON kiroha_sync_cursor(device_id);

getKirohaSyncCursor:
SELECT * FROM kiroha_sync_cursor WHERE space_id = :spaceId AND device_id = :deviceId;

upsertKirohaSyncCursor:
INSERT INTO kiroha_sync_cursor(space_id, device_id, revision, updated_at)
VALUES (:spaceId, :deviceId, :revision, :updatedAt)
ON CONFLICT(space_id, device_id) DO UPDATE SET
    revision = max(revision, :revision),
    updated_at = :updatedAt;
