CREATE TABLE kiroha_device(
    device_id TEXT NOT NULL PRIMARY KEY,
    device_name TEXT NOT NULL,
    platform TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    last_seen INTEGER NOT NULL,
    app_version TEXT NOT NULL,
    capabilities TEXT NOT NULL
);

CREATE TABLE kiroha_sync_event(
    event_id TEXT NOT NULL PRIMARY KEY,
    entity TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    revision INTEGER NOT NULL,
    timestamp INTEGER NOT NULL,
    device_id TEXT NOT NULL,
    payload TEXT NOT NULL,
    acknowledged INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX kiroha_sync_event_pending_index ON kiroha_sync_event(acknowledged, timestamp);
CREATE INDEX kiroha_sync_event_entity_index ON kiroha_sync_event(entity, entity_id, revision);

CREATE TABLE kiroha_download_record(
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    storage_id TEXT NOT NULL,
    state TEXT NOT NULL,
    downloaded_ever INTEGER NOT NULL,
    local_path TEXT,
    size INTEGER NOT NULL DEFAULT 0,
    checksum TEXT,
    downloaded_at INTEGER,
    last_verified_at INTEGER,
    deleted_at INTEGER
);
CREATE INDEX kiroha_download_item_index ON kiroha_download_record(item_id);
CREATE INDEX kiroha_download_device_index ON kiroha_download_record(device_id, state);
