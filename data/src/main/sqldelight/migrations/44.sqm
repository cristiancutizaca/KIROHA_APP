CREATE TABLE kiroha_sync_space(
    space_id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    global_revision INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE kiroha_sync_cursor(
    space_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(space_id, device_id)
);
CREATE INDEX kiroha_sync_cursor_device_index ON kiroha_sync_cursor(device_id);
